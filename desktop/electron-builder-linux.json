{
  "appId": "com.dramadesk.desktop",
  "productName": "DramaDesk",
  "directories": {
    "output": "release"
  },
  "files": [
    "main.js",
    "package.json",
    "backend-app/**/*",
    "node_modules/**/*"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/sharp/**",
    "backend-app/tools/**"
  ],
  "extraResources": [
    {
      "from": "frontweb-dist",
      "to": "frontweb/dist",
      "filter": ["**/*"]
    },
    {
      "from": "../example_drama",
      "to": "example_drama",
      "filter": ["**/*"]
    },
    {
      "from": "ffmpeg-linux",
      "to": "ffmpeg",
      "filter": ["ffmpeg", "ffprobe"]
    }
  ],
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "category": "AudioVideo",
    "executableName": "DramaDesk",
    "maintainer": "kapone-systems <noreply@github.com>",
    "synopsis": "Local AI short-drama generator",
    "artifactName": "DramaDesk-${version}-linux-${arch}.${ext}"
  }
}
